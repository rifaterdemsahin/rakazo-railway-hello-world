{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK"
  },
  "deploy": {
    "startCommand": "/http-echo -text=\"Hello World from Railway\" -listen=:8080",
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "sleepApplication": false,
    "multiRegionConfig": {
      "sfo": { "numReplicas": 1 }
    }
  }
}
